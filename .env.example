# ==============================================================================
# SAFEROUTE DELHI - ENVIRONMENT CONFIGURATION
# ==============================================================================
PROJECT_NAME="SafeRoute Delhi Backend"
ENVIRONMENT="development"
DEMO_MODE=true

# Set to false to send REAL live SMS/Emails.
# Set to true to mock/simulate (messages appear in-app under "Sent Alerts" tab):
MOCK_SMS=true

# ==============================================================================
# 1. SHARED DATABASE CONFIGURATION (FREE HOSTED OR LOCAL)
# ==============================================================================
# All app users share this database instance to view & submit community hazard reports.
# 
# OPTION A: SUPABASE (Recommended Free Hosted PostgreSQL - 500MB free)
#   1. Go to https://supabase.com and create a free account & project.
#   2. Go to Project Settings -> Database -> Connection String -> URI.
#   3. Paste the URL below (The backend automatically handles asyncpg):
#   DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
#
# OPTION B: NEON.TECH (Free Serverless PostgreSQL - 500MB free)
#   1. Go to https://neon.tech and create a free database.
#   2. Copy the connection string and paste here:
#   DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/neondb?sslmode=require"
#
# OPTION C: LOCAL SQLITE (Default - Zero setup required for local offline testing)
DATABASE_URL="postgresql://postgres:olPLMPf6raYr6BK3@db.gkruuzthmpvdqqwjtrwb.supabase.co:5432/postgres"

# ==============================================================================
# 2. FREE EMAIL NOTIFICATIONS SETUP (FOR EMERGENCY SOS DISPATCHES)
# ==============================================================================
# When an SOS or anomaly timer triggers, alerts are dispatched to trusted contact emails.
#
# OPTION A: GMAIL APP PASSWORD (100% FREE, ZERO-COST)
#   1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      Select "Other (Custom Name)", name it "SafeRoute", and click Generate.
#   3. Google gives you a 16-character password (e.g., abcd efgh ijkl mnop).
#   4. Enter your Gmail and that password below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""                    # e.g., "yourname@gmail.com"
SMTP_PASSWORD=""                # e.g., "abcdefghijklmnop" (16-char App Password, no spaces)
SMTP_FROM_EMAIL=""              # e.g., "SafeRoute Emergency <yourname@gmail.com>"

# OPTION B: RESEND API (Free 3,000 Emails / Month)
#   1. Sign up at https://resend.com (free tier)
#   2. Create an API key under API Keys:
RESEND_API_KEY=""               # e.g., "re_123456789abcdef"

# ==============================================================================
# 3. FREE / TRIAL SMS NOTIFICATIONS SETUP
# ==============================================================================
# OPTION A: FAST2SMS (Free Test Wallet for Indian Phone Numbers)
#   1. Sign up at https://www.fast2sms.com
#   2. Go to Dev API -> copy API Authorization Key:
FAST2SMS_API_KEY=""             # e.g., "ABC123XYZ..."

# OPTION B: TWILIO (Includes $15 Free Trial Credit on signup)
#   1. Sign up at https://www.twilio.com/try-twilio
#   2. Copy Account SID, Auth Token, and trial phone number:
TWILIO_ACCOUNT_SID=""           # e.g., "ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN=""            # e.g., "your_auth_token_here"
TWILIO_FROM_PHONE="+1234567890" # e.g., "+12055550199"

# ==============================================================================
# 4. SERVER & SECURITY
# ==============================================================================
ADMIN_PASSWORD="SafeDelhi2026"
SECRET_KEY="saferoute-delhi-secret-key-2026-hackathon"
PUBLIC_BASE_URL="http://localhost:8000"

# Optional: OpenRouteService API Key (Built-in offline Delhi preset routes work without this)
ORS_API_KEY=""

# Mobile App Public URL (For testing on physical phone on same WiFi, e.g. http://192.168.1.50:8000)
EXPO_PUBLIC_BACKEND_URL="http://localhost:8000"
