# SafeRoute Delhi Environment Configuration
PROJECT_NAME="SafeRoute Delhi Backend"
ENVIRONMENT="development"
DEMO_MODE=true
MOCK_SMS=true

# Database (Default: SQLite local database)
USE_LOCAL_DB=true
DATABASE_URL="sqlite+aiosqlite:///./saferoute.db"

# Admin Security Key
ADMIN_PASSWORD="SafeDelhi2026"
SECRET_KEY="saferoute-delhi-secret-key-2026-hackathon"

# Public Host URL for Live Tracking Links
PUBLIC_BASE_URL="http://localhost:8000"

# Optional External API Keys (Leave blank to use built-in fallbacks & mock mode)
ORS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE="+1234567890"

# Mobile App Public URL (For physical phone testing on same WiFi)
# Replace with your local machine's IP (e.g. http://192.168.1.50:8000)
EXPO_PUBLIC_BACKEND_URL="http://localhost:8000"
